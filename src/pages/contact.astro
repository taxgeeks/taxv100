---
import Base from '../layouts/Base.astro';
import PortalNotice from '../components/PortalNotice.astro';
import { site } from '../site';
---

<Base title="Contact" description={`Contact ${site.name} or book a consultation.`}>
  <section class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="text-3xl font-bold text-brand-900">Contact us</h1>
    <dl class="mt-8 grid gap-6 sm:grid-cols-2">
      <div>
        <dt class="text-sm font-semibold text-slate-500">Phone</dt>
        <dd class="mt-1"><a class="text-brand-600 hover:underline" href={`tel:${site.phone.replace(/[^\d+]/g, '')}`}>{site.phone}</a></dd>
      </div>
      <div>
        <dt class="text-sm font-semibold text-slate-500">Email</dt>
        <dd class="mt-1"><a class="text-brand-600 hover:underline" href={`mailto:${site.email}`}>{site.email}</a></dd>
      </div>
      <div>
        <dt class="text-sm font-semibold text-slate-500">Office</dt>
        <dd class="mt-1">{site.address}</dd>
      </div>
      <div>
        <dt class="text-sm font-semibold text-slate-500">Hours</dt>
        <dd class="mt-1">{site.hours}</dd>
      </div>
    </dl>
    <div class="mt-10">
      <a href={site.bookingUrl} class="rounded-md bg-brand-600 px-6 py-3 font-semibold text-white hover:bg-brand-700" rel="noopener">
        Book a consultation
      </a>
    </div>
    <div class="mt-10">
      <PortalNotice />
    </div>
  </section>
</Base>
