---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <section class="mx-auto max-w-3xl px-4 py-24 text-center">
    <h1 class="text-3xl font-bold text-brand-900">Page not found</h1>
    <p class="mt-4 text-slate-600">The page you're looking for doesn't exist.</p>
    <a href="/" class="mt-8 inline-block font-semibold text-brand-600 hover:underline">Back to home</a>
  </section>
</Base>
