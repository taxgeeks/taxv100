---
import Base from '../layouts/Base.astro';
import { site } from '../site';
---

<Base title="About" description={`About ${site.name}.`}>
  <section class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="text-3xl font-bold text-brand-900">About {site.name}</h1>
    <!-- TODO: replace with the firm's real story, team bios and credentials (EA, CPA, PTIN, etc.) -->
    <p class="mt-6 text-slate-600">
      [Placeholder] Tell clients who you are, how long you've been in practice, who you serve and what makes
      working with your firm different.
    </p>
    <h2 class="mt-12 text-xl font-semibold text-brand-900">Our team</h2>
    <p class="mt-4 text-slate-600">[Placeholder] Add team members, their roles and their credentials.</p>
  </section>
</Base>
