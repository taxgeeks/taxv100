---
import Base from '../layouts/Base.astro';
import { site, services } from '../site';
---

<Base title="Services" description="Tax preparation, planning, bookkeeping, payroll and IRS notice help.">
  <section class="mx-auto max-w-6xl px-4 py-16">
    <h1 class="text-3xl font-bold text-brand-900">Services</h1>
    <p class="mt-4 max-w-2xl text-slate-600">
      Not sure what you need? <a href="/contact" class="text-brand-600 hover:underline">Get in touch</a> and we'll help you figure it out.
    </p>
    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      {
        services.map((s) => (
          <div class="rounded-lg border border-slate-200 p-6">
            <h2 class="text-lg font-semibold text-brand-900">{s.title}</h2>
            <p class="mt-2 text-slate-600">{s.description}</p>
          </div>
        ))
      }
    </div>
    <div class="mt-12">
      <a href={site.bookingUrl} class="rounded-md bg-brand-600 px-6 py-3 font-semibold text-white hover:bg-brand-700" rel="noopener">
        Book a consultation
      </a>
    </div>
  </section>
</Base>
