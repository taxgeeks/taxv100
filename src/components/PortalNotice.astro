---
import { site } from '../site';
---

<div class="rounded-lg border border-amber-300 bg-amber-50 p-4 text-sm text-amber-900">
  <p class="font-semibold">Sending documents?</p>
  <p class="mt-1">
    Please upload W-2s, 1099s, IDs and anything with a Social Security or account number through our{' '}
    <a href={site.portalUrl} class="font-medium underline" rel="noopener">secure client portal</a>.
    Don't send them by email or text.
  </p>
</div>
