---
import { site, nav } from '../site';

const year = new Date().getFullYear();
---

<footer class="border-t border-slate-200 bg-slate-50 text-sm text-slate-600">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 sm:grid-cols-3">
    <div>
      <p class="font-semibold text-brand-900">{site.name}</p>
      <p class="mt-2">{site.address}</p>
      <p>{site.hours}</p>
    </div>
    <div>
      <p class="font-semibold text-brand-900">Contact</p>
      <p class="mt-2"><a class="hover:text-brand-600" href={`tel:${site.phone.replace(/[^\d+]/g, '')}`}>{site.phone}</a></p>
      <p><a class="hover:text-brand-600" href={`mailto:${site.email}`}>{site.email}</a></p>
    </div>
    <div>
      <p class="font-semibold text-brand-900">Pages</p>
      <ul class="mt-2 space-y-1">
        {nav.map((item) => <li><a class="hover:text-brand-600" href={item.href}>{item.label}</a></li>)}
        <li><a class="hover:text-brand-600" href={site.portalUrl} rel="noopener">Client Login</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-slate-200 py-4 text-center text-xs text-slate-500">
    <p>&copy; {year} {site.name}. All rights reserved.</p>
    <p class="mt-1">
      Information on this site is general and is not tax advice for your situation.
      Never send tax documents or Social Security numbers by email. Use the secure client portal.
    </p>
  </div>
</footer>
